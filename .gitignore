# Only the website and its maintenance files belong in the public repository.
*
!.gitignore
!.gitattributes
!README.md
!package.json
!package-lock.json
!.github/
!.github/workflows/
!.github/workflows/pages.yml
!site/
!site/**
!tests/
!tests/site.mjs
!tests/requirements.json
!scripts/
!scripts/preview.py

.env
.env.*
*.pem
*.key
